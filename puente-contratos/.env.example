# Token compartido con LiciColba (cabecera «Authorization: Bearer <token>»). Obligatorio, mínimo 16 caracteres.
PUENTE_TOKEN=

# dry-run: valida el JSON y responde lo que escribiría, SIN escribir en MySQL (con o sin MySQL configurado).
# escritura: crea la oferta en MySQL (módulo 4). Exige MySQL configurado y el esquema esperado de los módulos implementados;
# probarlo siempre primero contra una base de prueba (ver README).
PUENTE_MODO=dry-run

PUENTE_PORT=4010

# Por defecto solo escucha en local. En Docker usar 0.0.0.0 y NO publicar el puerto fuera de la red interna.
PUENTE_HOST=127.0.0.1

# MySQL de Contratos (5.5, tablas latin1). Sin PUENTE_MYSQL_HOST el puente funciona solo en modo dry-run.
# Usar un usuario propio del puente con permisos mínimos (SELECT en lo que consulta; INSERT/UPDATE/DELETE solo en las
# tablas de la oferta). Nunca el usuario de Visual FoxPro ni uno con permisos de DDL.
PUENTE_MYSQL_HOST=
PUENTE_MYSQL_PORT=3306
PUENTE_MYSQL_USER=
PUENTE_MYSQL_PASSWORD=
PUENTE_MYSQL_DATABASE=almacen
