# Token compartido con LiciColba (cabecera «Authorization: Bearer <token>»). Obligatorio, mínimo 16 caracteres.
PUENTE_TOKEN=

# dry-run (módulo 1): valida el JSON y responde lo que escribiría, SIN tocar MySQL.
# escritura: reservado para el módulo MySQL (hoy responde 501).
PUENTE_MODO=dry-run

PUENTE_PORT=4010

# Por defecto solo escucha en local. En Docker usar 0.0.0.0 y NO publicar el puerto fuera de la red interna.
PUENTE_HOST=127.0.0.1
