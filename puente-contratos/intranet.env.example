# Puente LiciColba → Contratos contra el MySQL de la INTRANET (copia de producción del servidor de Pruebas).
# Se usa con docker-compose.intranet.yml:   copy intranet.env.example .env   (Docker Compose lee .env solo; .env no va a git)

# Token compartido con LiciColba: en su .env.local, PUENTE_CONTRATOS_TOKEN con este mismo valor (mínimo 16 caracteres).
# El de ejemplo sirve solo para probar en este equipo (el puerto se publica solo en 127.0.0.1): cámbielo al desplegar.
PUENTE_TOKEN=token-local-de-prueba-0123456789

# escritura = crea la oferta en Contratos. dry-run = solo valida y muestra lo que escribiría, sin tocar la base.
PUENTE_MODO=escritura

# Dónde se publica el 4010 en este equipo: 127.0.0.1 = solo este equipo; 0.0.0.0 = toda la red (el token es lo único que lo protege).
PUENTE_PUBLICAR=127.0.0.1

# MySQL de Contratos: la IP del servidor de Pruebas (la misma de la conexión de SQLyog) y la base.
PUENTE_MYSQL_HOST=
PUENTE_MYSQL_PORT=3306
PUENTE_MYSQL_DATABASE=almacen

# Usuario propio del puente con permisos mínimos (README, paso 1). NUNCA root ni el usuario de Visual FoxPro.
PUENTE_MYSQL_USER=puente
# Su clave (vacía si el usuario no tiene). Si lleva $ o #, enciérrela entre comillas simples: PUENTE_MYSQL_PASSWORD='clave'
PUENTE_MYSQL_PASSWORD=
