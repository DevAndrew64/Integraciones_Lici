# Puente LiciColba → Contratos en LOCAL, escribiendo en la base de PRUEBA de Docker (test/mysql/docker-compose.yml):
#   npm run mysql:prueba:arriba   ·   npm run mysql:prueba:datos   ·   npm run start:prueba
# Valores de ejemplo SIN valor fuera de este equipo: ni el token ni la clave sirven contra nada real.
# En LiciColba (.env.local) use el MISMO token:
#   PUENTE_CONTRATOS_URL=http://127.0.0.1:4010
#   PUENTE_CONTRATOS_TOKEN=token-local-de-prueba-0123456789
PUENTE_TOKEN=token-local-de-prueba-0123456789
PUENTE_MODO=escritura
PUENTE_PORT=4010
PUENTE_HOST=127.0.0.1
PUENTE_MYSQL_HOST=127.0.0.1
PUENTE_MYSQL_PORT=3307
PUENTE_MYSQL_USER=puente
PUENTE_MYSQL_PASSWORD=prueba-local-sin-valor
PUENTE_MYSQL_DATABASE=almacen_prueba
