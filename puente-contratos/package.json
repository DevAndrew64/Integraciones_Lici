{
  "name": "puente-contratos",
  "version": "0.1.0",
  "private": true,
  "description": "Servicio puente LiciColba → Contratos (MySQL 5.5 / Visual FoxPro)",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "test:mysql": "node --env-file=test/mysql/prueba.env --test test/mysql.integracion.test.js",
    "mysql:prueba:arriba": "docker compose -f test/mysql/docker-compose.yml up -d --wait",
    "mysql:prueba:abajo": "docker compose -f test/mysql/docker-compose.yml down -v",
    "mysql:prueba:datos": "docker compose -f test/mysql/docker-compose.yml exec -T mysql55 mysql -uroot -pprueba-root-local almacen_prueba < test/mysql/datos-prueba.sql",
    "start:prueba": "node --env-file=test/mysql/puente-local.env src/server.js",
    "esquema:actualizar": "node src/herramientas/exportar-esquema.js",
    "permisos:generar": "node src/herramientas/generar-permisos.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mysql2": "^3.24.5"
  }
}
