# ═══════════════════════════════════════════════════════════════════════════
# licycolba-final — variables de entorno (plantilla).
# Copiar a .env / .env.local y completar. NUNCA versionar valores reales.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Base de datos (PostgreSQL) ─────────────────────────────────────────────
# Conexión de la app (dominio, solicitudes, notificaciones, análisis, usuarios,
# configuración, etc.). Prisma la usa directamente.
DATABASE_URL=

# ─── Sesiones ──────────────────────────────────────────────────────────────
SESSION_SECRET=

# ─── Proveedor de IA por defecto ───────────────────────────────────────────
# Valores permitidos: gemini | anthropic
AI_DEFAULT_PROVIDER=gemini

# ─── Google Gemini (proveedor principal de IA) ─────────────────────────────
GOOGLE_AI_API_KEY=
GEMINI_MODEL=

# ─── Anthropic Claude (segundo proveedor de IA, análisis de bajo costo) ────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_TIMEOUT=45
ANTHROPIC_MAX_INPUT_CHARS=12000
ANTHROPIC_DEFAULT_MAX_TOKENS=600
# Habilitar el endpoint de prueba /api/ai/anthropic/test en producción (0|1)
ANTHROPIC_TEST_ENDPOINT_ENABLED=0

# ─── Google Document AI (OCR de documentos escaneados) ─────────────────────
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
DOCUMENT_AI_ENABLED=
DOCUMENT_AI_OCR_PROCESSOR_ID=
DOCUMENT_AI_MAX_INLINE_MB=
DOCUMENT_AI_MAX_INLINE_PAGES=

# ─── API pública de indicadores (/api/public/v1) ──────────────────────────
# 'false' deshabilita toda la API pública. Sin claves en api_clients tampoco
# responde datos aunque esté habilitada.
PUBLIC_API_ENABLED=true
PUBLIC_API_RATE_LIMIT_DEFAULT=60
# URL pública de la app (documentación/enlaces; no afecta el runtime).
APP_PUBLIC_URL=https://your-domain.example

# ─── Adquisición / sincronización de procesos ────────────────────────────
# La ÚNICA vía de adquisición / sincronización de procesos es un servicio de
# datos de procesos, HTTP y autenticado, configurado por estas variables. El
# backend/frontend entregado NO accede directamente a la fuente pública de
# procesos.
#
# Endpoint y credencial del servicio de datos de procesos (NUNCA versionar el
# valor real):
DATA_API_BASE_URL=
DATA_API_KEY=
# Timeout HTTP del cliente en ms (ausente = 30000). Recomendado: 10000.
DATA_API_TIMEOUT_MS=10000
# Tamaño de página pedido a /sincronizar (ausente = 30).
DATA_API_SYNC_LIMITE=30

# Cron del sync principal en modo data-api (override opcional). Default del
# código = cada 5 minutos. El sync profundo diario usa SYNC_PROFUNDO_CRON
# (default 0 4 * * *).
SYNC_CRON=*/5 * * * *

# ── Activación de la sincronización automática ────────────────────────────
# Default seguro de un deployment nuevo = TODO OFF: la app NO adquiere ni
# escribe procesos por arrancar. Para ACTIVAR la sincronización automática
# cada 5 min hay que poner, TODAS a la vez, estos 5 valores:
#     SYNC_RUNTIME_MODE=data-api
#     DATA_API_RUNTIME_ENABLED=true
#     DATA_API_RUNTIME_WRITE_ENABLED=true
#     DATA_API_RUNTIME_DATABASE_URL=<connection string del destino de escritura>
#     DATA_API_RUNTIME_EXPECTED_SYSTEM_IDENTIFIER=<system_identifier real del destino>
# Si falta o no coincide cualquiera de ellos, el guardrail aborta ANTES de
# escribir y la sincronización queda desactivada (log neutral, sin secretos).

# Feature flag del runtime de adquisición. Solo un token afirmativo explícito
# lo enciende ({true,1,on,yes,enabled}, case-insensitive). OFF → la app NO
# adquiere procesos.
DATA_API_RUNTIME_ENABLED=false

# Modo de adquisición en runtime:
#   disabled  → no adquiere nada (default seguro para un deployment nuevo)
#   data-api  → adquiere vía la Data API (requiere el flag ON + las vars de abajo)
# El valor 'legacy' NO es seleccionable en este repositorio: si se pasa, se
# interpreta como 'disabled' con una advertencia en log.
SYNC_RUNTIME_MODE=disabled

# Debe ser exactamente "true" para habilitar CUALQUIER escritura del runner de
# sincronización sobre su destino. El guardrail aborta antes de escribir si no
# es "true".
DATA_API_RUNTIME_WRITE_ENABLED=false

# Connection string del DESTINO DE ESCRITURA de la sincronización. Puede
# apuntar al mismo destino lógico que DATABASE_URL (misma instancia física);
# el guardrail lo verifica por system_identifier real, no por texto de URL.
DATA_API_RUNTIME_DATABASE_URL=

# Identidad POSITIVA del destino de escritura: system_identifier del cluster
# PostgreSQL esperado (SELECT system_identifier FROM pg_control_system()).
# El guardrail aborta toda escritura si el system_identifier real no coincide.
DATA_API_RUNTIME_EXPECTED_SYSTEM_IDENTIFIER=

# (Opcional) system_identifier PROHIBIDO como destino de escritura — defensa en
# profundidad para bloquear una instancia concreta (p. ej. una de staging).
# Si se define y el destino real coincide con este valor, el guardrail aborta.
DATA_API_RUNTIME_FORBIDDEN_SYSTEM_IDENTIFIER=

# ─── Integraciones ─────────────────────────────────────────────────────────
UPLOADTHING_TOKEN=
# Bearer token para las rutas de n8n listadas en src/proxy.ts. En este
# repositorio n8n SOLO desbloquea la ingestión RAG (/api/lectura/rag/ingestar);
# nunca rutas de adquisición de procesos.
N8N_SYNC_TOKEN=

# ─── Puente LiciColba → Contratos (puente-contratos/) ──────────────────────
# Sin URL o sin token la integración queda APAGADA: "Enviar a Contratos" responde
# "aún no está habilitada". El token debe ser el mismo PUENTE_TOKEN del puente.
# El puente corre solo en la red interna (ver puente-contratos/README.md).
PUENTE_CONTRATOS_URL=
PUENTE_CONTRATOS_TOKEN=
# (Opcional) tiempo máximo de espera al puente, en ms (500–120000). Por defecto 8000.
PUENTE_CONTRATOS_TIMEOUT_MS=
