  objeto            String?
  fuente            String?
  aliasFuente       String?
  modalidad         String?
  perfil            String?
  departamento      String?
  estadoFuente      String?
  fechaPublicacion  DateTime?
  fechaVencimiento  DateTime?
  valor             Float?
  linkDetalle       String?
  linkSecop         String?
  linkSecopReg      String?
  estadoSolicitud   String?
  observacion       String?
  ciudad            String?
  sede              String?
  plataforma        String?
  fechaCierre       DateTime?
  procStep          Int       @default(0)
