generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  cedula       String
  celular      String
  entidadGrupo String
  cargo        String
  email        String   @unique
  usuario      String
  rol          String
  estado       String
  firmaDigital String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  proceso         String?
  subproceso      String?
  uen             String?
  sessionVersion  Int     @default(1)

  analisis            LecturaAnalisis[]
  auditLogs           AuditLog[]
  rateLimitGemini     RateLimitGemini[]
  geminiUsages        GeminiUsage[]
  simulaciones        SimulacionPonderacion[]
  metodosRevisados    MetodoPonderacionProceso[] @relation("MetodosRevisadosPor")
  lecturasGestionadas LecturaAnalisis[]          @relation("LecturasGestionadas")

  docsAnalisisEconomicoCargados DocumentoAnalisisEconomicoProceso[] @relation("DocsAnalisisEconomicoCargados")
  analisisEconomicoEjecutados   AnalisisEconomicoProceso[]          @relation("AnalisisEconomicoEjecutados")
  reglasTrmCreadas              ReglaTrmProceso[]                   @relation("ReglasTrmCreadas")
  reglasTrmAprobadas            ReglaTrmProceso[]                   @relation("ReglasTrmAprobadas")
  reglasTrmRechazadas           ReglaTrmProceso[]                   @relation("ReglasTrmRechazadas")
  conjuntosMetodosCreados       ConjuntoMetodosPonderacionProceso[] @relation("ConjuntosMetodosCreados")
  conjuntosMetodosAprobados     ConjuntoMetodosPonderacionProceso[] @relation("ConjuntosMetodosAprobados")
  conjuntosMetodosRechazados    ConjuntoMetodosPonderacionProceso[] @relation("ConjuntosMetodosRechazados")
  excepcionesCandidataDecididas DecisionExcepcionCandidata[]        @relation("ExcepcionesCandidataDecididas")
}

model DeletedUser {
  id               Int      @id @default(autoincrement())
  originalUserId   Int?
  cedula           String
  celular          String
  entidadGrupo     String
  cargo            String
  email            String
  usuario          String
  rol              String
  estado           String
  firmaDigital     String?
  createdAt        DateTime
  updatedAt        DateTime
  deletedAt        DateTime @default(now())
  deletedByUsuario String?
  deletedByEmail   String?
  deletedByCargo   String?
  proceso          String?
  subproceso       String?
  uen              String?
}

model Notificacion {
  id            Int       @id @default(autoincrement())
  tipo          String
  titulo        String
  descripcion   String?
  codigoProceso String?
  procesoId     Int?
  entidad       String?
  perfil        String?
  leida         Boolean   @default(false)
  datos         Json?
  creadoEn      DateTime  @default(now())
  leidaEn       DateTime?
  // B.3 — clave de idempotencia para notificaciones generadas por el
  // aplicador de la Data API (proceso_nuevo:/documento_nuevo:/cronograma_cambio:).
  // Nullable: las notificaciones legacy no la llevan; UNIQUE garantiza que
  // el aplicador nunca cree dos veces la misma notificación.
  claveIdempotencia String? @unique

  @@index([leida])
  @@index([tipo])
  @@index([perfil])
  @@index([creadoEn])
  @@index([codigoProceso])
  @@index([procesoId])
  @@index([tipo, procesoId, creadoEn])
}

model Proceso {
  id                       Int                      @id @default(autoincrement())
  externalId               String?                  @unique
  codigoProceso            String?
  nombre                   String?
  entidad                  String?
  objeto                   String?
  fuente                   String?
  aliasFuente              String?
  modalidad                String?
  perfil                   String?
  departamento             String?
  estadoFuente             String?
  fechaPublicacion         DateTime?
  fechaVencimiento         DateTime?
  valor                    Float?
  linkDetalle              String?
  linkSecop                String?
  linkSecopReg             String?
  totalCronogramas         Int                      @default(0)
  totalDocumentos          Int                      @default(0)
  rawJson                  String?
  hashContenido            String?
  lastSyncedAt             DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  sourceKey                String                   @unique
  duracion                 String?
  fechaVencimientoAnterior DateTime?
  fechaCambioFechaCierre   DateTime?
  tieneCambioFechaCierre   Boolean                  @default(false)
  noViable                 Boolean                  @default(false)
  observacionNoViable      String?
  noViableRegistradoPor    String?
  noViableFecha            DateTime?
  actividadLicy            String?
  clasificacionAt          DateTime?
  unspsc                   String?
  scraperIntentos          Int?
  scraperUltimoIntento     DateTime?
  scraperError             String?
  scraperEstado            String?
  scraperTipoFuente        String?
  scraperScore             Float?
  scraperTodosLinks        String?
  oculto                   Boolean?                 @default(false)
  // ── B.3 — espejo local del estado de el servicio de datos ──────────────
  // `disponibleDataApi` NUNCA hereda `true` por el mero hecho de existir la
  // fila: default `false` — solo un UPSERT real de la Data API lo enciende
  // (ver mapeoCanonico.datosCreacionProceso). `retiradoDataApiEn` sella el
  // tombstone (la fila nunca se borra). `ultimoSnapshotId` es la marca del
  // último full-resync que tocó la fila (base de la reconciliación).
  // `origenFuncional` persiste el concepto canónico — nunca un proveedor —
  // y es la protección PRIMARIA de los procesos MANUAL frente a la
  // reconciliación (la convención `sourceKey` `local:%` queda solo como
  // compatibilidad con registros históricos).
  disponibleDataApi        Boolean                  @default(false)
  retiradoDataApiEn        DateTime?
  ultimoSnapshotId         String?
  origenFuncional          OrigenFuncionalCanonico?
  cronogramasSecop         ProcesoCronogramaSecop[]
  detalleSecop             ProcesoDetalleSecop?
  documentosSecop          ProcesoDocumentoSecop[]
  snapshotsSecop           ProcesoSnapshotSecop[]
  simulaciones             SimulacionPonderacion[]
  metodosExtraidos         MetodoPonderacionProceso[]
  estadoRevisionPliego     EstadoRevisionPliego  @default(SIN_ANALIZAR)
  /// ¿La TRM gobierna la evaluación económica de este proceso? Gate del flujo.
  usaPonderacionTrm        UsoPonderacionTrm     @default(NO_DETERMINADO)
  documentosAnalisisEconomico DocumentoAnalisisEconomicoProceso[]
  analisisEconomico        AnalisisEconomicoProceso[]
  reglasTrm                ReglaTrmProceso[]
  conjuntosMetodosPonderacion ConjuntoMetodosPonderacionProceso[]

  @@index([codigoProceso])
  @@index([perfil])
  @@index([aliasFuente])
  @@index([departamento])
  @@index([estadoFuente])
  @@index([fechaPublicacion])
  @@index([fechaVencimiento])
  @@index([tieneCambioFechaCierre])
  @@index([linkDetalle])
  @@index([scraperEstado, scraperIntentos])
  @@index([scraperIntentos, scraperUltimoIntento])
  @@index([scraperUltimoIntento])
  @@index([aliasFuente], map: "idx_proceso_alias_fuente")
  @@index([id], map: "idx_proceso_link_detalle_null", where: raw("((\"linkDetalle\" IS NULL) OR (\"linkDetalle\" = ''::text))"))
  @@index([fechaPublicacion(sort: Desc)], map: "idx_proceso_linkdetalle_null_fecha", where: raw("((\"linkDetalle\" IS NULL) OR (TRIM(BOTH FROM \"linkDetalle\") = ''::text))"))
  @@index([perfil], map: "idx_proceso_perfil")
}

model ProcesoDetalleSecop {
  id                      Int       @id @default(autoincrement())
  procesoId               Int       @unique
  urlConsulta             String?
  urlFinal                String?
  titulo                  String?
  estado                  String?
  fase                    String?
  tipoProceso             String?
  tipoContrato            String?
  justificacionModalidad  String?
  duracionContrato        String?
  fechaTerminacion        DateTime?
  direccionEjecucion      String?
  codigoUnspsc            String?
  unspscAdicionales       Json?
  esMipymes               Boolean?
  esPaa                   Boolean?
  vigenciaPaa             String?
  misionVision            String?
  valorAdquisiciones      Float?
  valorTotalProceso       Float?
  cuestionarioJson        Json?
  informacionPresupuestal Json?
  textoPlano              String?
  hashDetalle             String?
  capturadoEn             DateTime  @default(now())
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  proceso                 Proceso   @relation(fields: [procesoId], references: [id], onDelete: Cascade)

  @@index([estado])
  @@index([capturadoEn])
  @@index([updatedAt])
}

model ProcesoCronogramaSecop {
  id                 Int       @id @default(autoincrement())
  procesoId          Int
  evento             String
  valorTexto         String?
  fechaInicio        DateTime?
  fechaFin           DateTime?
  zonaHoraria        String?
  orden              Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  valorTextoAnterior String?
  fechaActualizacion DateTime?
  tieneCambioFecha   Boolean   @default(false)
  proceso            Proceso   @relation(fields: [procesoId], references: [id], onDelete: Cascade)

  @@index([procesoId])
  @@index([evento])
  @@index([updatedAt])
}

model ProcesoDocumentoSecop {
  id             Int      @id @default(autoincrement())
  procesoId      Int
  nombre         String
  urlDocumento   String?
  tipoDocumento  String?
  // B.3 — id del documento en el servicio de datos. Nullable: los
  // documentos legacy no lo llevan. El contrato canónico NO garantiza que
  // `docId` sea único globalmente, solo dentro de su proceso — por eso la
  // unicidad es compuesta (procesoId, dataApiDocId), no un @unique simple.
  dataApiDocId   String?
  extension      String?
  hashArchivo    String?
  rutaLocal      String?
  mimeType       String?
  tamanoBytes    Int?
  textoExtraido  String?
  descargado     Boolean  @default(false)
  procesado      Boolean  @default(false)
  fechaDetectado DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  proceso        Proceso  @relation(fields: [procesoId], references: [id], onDelete: Cascade)

  @@unique([procesoId, dataApiDocId])
  @@index([procesoId])
  @@index([nombre])
  @@index([tipoDocumento])
  @@index([descargado])
  @@index([procesado])
  @@index([fechaDetectado])
  @@index([updatedAt])
}

model ProcesoSnapshotSecop {
  id            Int      @id @default(autoincrement())
  procesoId     Int
  urlConsulta   String?
  hashContenido String?
  payloadJson   Json
  creadoEn      DateTime @default(now())
  proceso       Proceso  @relation(fields: [procesoId], references: [id], onDelete: Cascade)

  @@index([procesoId])
  @@index([creadoEn])
}

/// Estado ÚNICO e identificable de la sincronización con el servicio de
/// datos. Es un singleton: exactamente una fila, con `clave = "procesos"`
/// (nunca una colección accidental de estados independientes). El
/// `checkpointCursor` es el checkpoint INCREMENTAL definitivo — solo avanza
/// en páginas de sync incremental normal, o al promoverse explícitamente al
/// completar un full resync. Los campos `fullResync*` son exclusivamente el
/// estado TRANSITORIO de un full resync en curso.
model DataApiSyncState {
  clave                    String    @id
  checkpointCursor         String?
  checkpointActualizadoEn  DateTime?
  fullResyncSnapshotId     String?
  fullResyncNextPageCursor String?
  fullResyncIniciadoEn     DateTime?
}

model ProcesoNuevo {
  id               Int       @id @default(autoincrement())
  procesoId        Int?
  sourceKey        String    @unique
  codigoProceso    String?
  nombre           String?
  entidad          String?
  objeto           String?
  fuente           String?
  aliasFuente      String?
  modalidad        String?
  perfil           String?
  departamento     String?
  estadoFuente     String?
  fechaPublicacion DateTime?
  fechaVencimiento DateTime?
  valor            Float?
  linkDetalle      String?
  linkSecop        String?
  linkSecopReg     String?
  fechaDeteccion   DateTime  @default(now())
  duracion         String?

  @@index([fechaDeteccion])
  @@index([perfil])
  @@index([aliasFuente])
  @@index([codigoProceso])
}

model Solicitud {
  id                Int       @id @default(autoincrement())
  procesoId         Int?
  procesoSourceKey  String?
  externalId        String?
  codigoProceso     String?
  nombreProceso     String?
  entidad           String?
  objeto            String?
  fuente            String?
  aliasFuente       String?
  modalidad         String?
  perfil            String?
  departamento      String?
  estadoFuente      String?
  fechaPublicacion  DateTime?
  fechaVencimiento  DateTime?
  valor             Float?
  linkDetalle       String?
  linkSecop         String?
  linkSecopReg      String?
  estadoSolicitud   String    @default("En revisión")
  observacion       String?
  usuarioRegistro   String?
  emailRegistro     String?
  cargoRegistro     String?
  entidadRegistro   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  aprobador         String?
  asignaciones      Json      @default("[]")
  ciudad            String?
  docData           Json      @default("[]")
  fechaCierre       DateTime?
  obsData           Json      @default("[]")
  plataforma        String?
  procData          Json      @default("{}")
  procStep          Int       @default(0)
  revisor           String?
  sede              String?
  causalCierre      String?
  fechaAperturaSqr  DateTime?
  fechaCierreSqr    DateTime?
  resultadoFinal    String?
  sqrCerrada        Boolean   @default(false)
  sqrCreada         Boolean   @default(false)
  sqrError          String?
  sqrNumero         String?
  // Ajuste "CIERRE DE SQR AL PRESENTAR" — estado explícito del intento de
  // cierre externo en GrupoColba: PENDIENTE|CERRANDO|CERRADA|ERROR. `null`
  // en registros anteriores a este ajuste equivale a PENDIENTE, salvo que
  // `sqrCerrada` ya sea `true` (entonces equivale a CERRADA) — ver
  // `resolverEstadoCierreSqrEfectivo`. Nunca se hace backfill que escriba
  // CERRADA retroactivamente; el valor solo se escribe hacia adelante.
  sqrCierreEstado   String?
  // Ajuste "ESTADO FINAL SQR (booleano)" — señal EXPLÍCITA, booleana, que
  // reciben tanto la persistencia como el motor de cierre de SQR
  // (`intentarCerrarSqrSiCorresponde`) para decidir el payload/validación
  // de GrupoColba, SIN que el motor tenga que interpretar `estadoRevision`:
  // `true` (únicamente vía la acción real "Presentar proceso" — exige
  // descripción + evidencia) | `false` (cualquier cierre terminal —
  // Rechazado, Cerrar sin presentar, Cancelado — ocurrido SIN haber
  // presentado — exige solo observación, nunca evidencia) | `null` =
  // histórico (no se puede demostrar con certeza cómo terminó) o proceso
  // aún no terminado — NUNCA se infiere/asume como `false`. Un proceso ya
  // en `true` que luego se adjudica/no-adjudica CONSERVA ese valor — el
  // cierre final posterior nunca lo degrada a `false`.
  estadoFinalSqr    Boolean?
  origenSolicitud   String    @default("Comercial")
  correoContacto    String?
  direccionContacto String?
  nitContacto       String?
  personaContacto   String?
  telefonoContacto  String?
  duracion          String?
  fechaEntregaInfo  DateTime?
  // Ajuste "SEGUIMIENTO — MERCADEO" — historial de anotaciones INMUTABLES
  // sobre la evolución del proceso (nunca una sola observación editable —
  // cada registro es un elemento nuevo, nunca se reemplaza uno existente).
  // Mismo patrón ya usado por `asignaciones`/`docData`/`obsData`: array JSON
  // manipulado en TypeScript, sin tabla relacionada. Forma de cada elemento
  // (ver `src/lib/solicitudes/seguimiento.ts`): { id, texto, creadoEn,
  // creadoPor, rol }. Requiere la migración
  // `20260825180000_add_seguimiento_solicitud` aplicada contra la BD real
  // ANTES de `npx prisma generate` — de lo contrario cualquier
  // `findUnique`/`findMany` de `Solicitud` sin `select` explícito falla con
  // "column does not exist" (incidente ya ocurrido una vez, ver historial).
  observacionesSeguimiento Json @default("[]")

  @@index([estadoSolicitud])
  @@index([codigoProceso])
  @@index([procesoId])
  @@index([procesoSourceKey])
  @@index([origenSolicitud])
  @@index([sqrNumero])
  @@index([sqrCreada])
  @@index([sqrCerrada])
  @@index([createdAt(sort: Desc)])
  @@index([aliasFuente])
  @@index([revisor])
  @@index([aprobador])
  @@index([estadoSolicitud, createdAt(sort: Desc)])
  @@index([origenSolicitud, estadoSolicitud, createdAt(sort: Desc)])
}

